{
  "name": "Praise God Productions",
  "short_name": "Praise God",
  "description": "Faith. Creativity. Purpose. Legacy.",
  "id": "/",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#180713",
  "theme_color": "#180713",
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": ["entertainment", "music", "lifestyle"],
  "icons": [
    {
      "src": "/public/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/public/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/public/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Upcoming Events",
      "short_name": "Events",
      "url": "/#events",
      "icons": [{"src": "/public/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml"}]
    },
    {
      "name": "Submit Talent",
      "short_name": "Submit",
      "url": "/#submit",
      "icons": [{"src": "/public/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml"}]
    },
    {
      "name": "Connect",
      "short_name": "Connect",
      "url": "/#connect",
      "icons": [{"src": "/public/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml"}]
    }
  ]
}
